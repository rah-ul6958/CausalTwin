# CausalTwin backend settings. Every variable is optional; the defaults suit a laptop.
# Copy to .env (or set them in your host's dashboard). Read once at start-up.

# Port uvicorn listens on inside the container. Render sets this automatically.
PORT=8000

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Local: http://localhost:3000. Deployed: your Vercel URL, for example https://causaltwin.vercel.app
CAUSALTWIN_CORS_ORIGINS=http://localhost:3000

# Optional regular expression for extra allowed origins, for example Vercel preview deployments:
# CAUSALTWIN_CORS_ORIGIN_REGEX=https://causaltwin-.*\.vercel\.app
CAUSALTWIN_CORS_ORIGIN_REGEX=

# Each browser tab gets its own private live simulation, so one viewer's Reset, fault or guided demo
# does not change what other viewers see. At most this many exist at once; later viewers share one
# simulation and the top bar says so. A simulation steps only while someone watches its live stream,
# and a private one is deleted 10 minutes after its tab closes. Watched simulations share the CPU: on
# the development laptop each ran at about 3.8 steps per second alone, 2.9 with two and 2.0 with four
# watched at once (target 5). 0 makes every viewer share one simulation.
CAUSALTWIN_MAX_SESSIONS=4

# The shared simulation (used by scripts, health checks and viewers beyond the limit above):
# 1 (default) starts it running; 0 starts it paused. Private simulations always start running.
# With a real machine (MTConnect) or with CAUSALTWIN_MAX_SESSIONS=0, it steps even when nobody watches.
CAUSALTWIN_AUTOSTART=1

# Worker processes for causal (re-)discovery. 5 is fastest on a laptop; each worker costs memory,
# so use 1 on small servers (the Docker image defaults to 1). Results are identical either way.
CAUSALTWIN_DISCOVERY_JOBS=5

# 1 allows POST /benchmark/run (the "Re-run benchmark" button, about a minute of full CPU).
# Set 0 on a public deployment so visitors cannot slow the demo down; cached results still show.
CAUSALTWIN_ALLOW_BENCHMARK_RUN=1

# Where the live data comes from (see causaltwin/connectors/):
#   simulator (default) - the built-in simulated spindle, with ground truth, faults, scenarios and the demo
#   replay              - stream a recorded CSV as if it were live (CAUSALTWIN_REPLAY_PATH)
#   mtconnect           - read a real machine's MTConnect agent once per step (CAUSALTWIN_MTCONNECT_URL)
# With replay or mtconnect there is no ground truth and recommendations are advisory.
CAUSALTWIN_DATA_SOURCE=simulator
CAUSALTWIN_REPLAY_PATH=
# 1 if the replayed log is itself simulated (the sample CSVs are), so the UI keeps the "Simulated" label.
CAUSALTWIN_REPLAY_SIMULATED=1
CAUSALTWIN_MTCONNECT_URL=
# JSON object {model variable: MTConnect data item id or CSV column}. Optional extra keys:
# "machine_running" (an Execution/Availability item) and "failure" (a Condition item; FAULT = failure).
# Example for the stand-in agent: python scripts/fake_mtconnect_agent.py --print-tag-map
CAUSALTWIN_TAG_MAP=
