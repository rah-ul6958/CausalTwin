# Settings for `docker compose up` (copy to .env next to docker-compose.yml to change them).
# Backend-only settings are documented in backend/.env.example, frontend ones in frontend/.env.example.

# Host ports.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# The browser loads the frontend from the host, then calls the backend directly, so these are the
# backend's addresses as seen from the browser (not the internal Docker name "backend").
# They are baked into the frontend at build time: run `docker compose build` after changing them.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream

# Must contain the frontend's address as the browser sees it.
CAUSALTWIN_CORS_ORIGINS=http://localhost:3000

# Discovery worker processes (more is faster, each costs memory) and benchmark re-runs.
CAUSALTWIN_DISCOVERY_JOBS=2
CAUSALTWIN_ALLOW_BENCHMARK_RUN=1

# Private live simulations at once (one per browser tab; later viewers share one). 0 turns them off.
CAUSALTWIN_MAX_SESSIONS=4
